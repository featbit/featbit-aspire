<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>5.4.4</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="$(AspireHostingSDKVersion)" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="$(AspireHostingSDKVersion)" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="$(AspireHostingSDKVersion)" />
  </ItemGroup>
</Project>
